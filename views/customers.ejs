<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">

    <div class="container">

        <a class="navbar-brand fw-bold" href="/dashboard">
            📦 Elite Globex ERP
        </a>

        <div class="ms-auto">

            <a href="/dashboard" class="btn btn-outline-light btn-sm me-2">
                🏠 Dashboard
            </a>

            <a href="/customers" class="btn btn-outline-light btn-sm me-2">
                👥 Customers
            </a>

            <a href="/products" class="btn btn-outline-light btn-sm me-2">
                📦 Products
            </a>

            <a href="/orders" class="btn btn-outline-light btn-sm me-2">
                📋 Orders
            </a>

            <a href="/logout" class="btn btn-danger btn-sm">
                🚪 Logout
            </a>

        </div>

    </div>

</nav>

<div class="container mt-4">

    <% if(success && success.length > 0){ %>

<div class="alert alert-success alert-dismissible fade show mt-3" role="alert">

    ✅ <%= success[0] %>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert">
    </button>

</div>

<% } %>

<% if(error && error.length > 0){ %>

<div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">

    ❌ <%= error[0] %>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert">
    </button>

</div>

<% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Customer Management</h2>

        <a href="/customers/add" class="btn btn-success">
    ➕ Add Customer
</a>

    </div>

    <!-- Search Box -->
    <div class="mb-3">

        <input
            type="text"
            id="searchCustomer"
            class="form-control"
            placeholder="Search Customer...">

    </div>

    <table class="table table-bordered table-hover">

        <thead class="table-dark">

            <tr>

                <th>ID</th>
                <th>Customer Name</th>
                <th>Company</th>
                <th>Phone</th>
                <th>Email</th>
                <th width="170">Action</th>

            </tr>

        </thead>

        <tbody id="customerTable">

        <% if(customers.length > 0){ %>

            <% customers.forEach(function(customer){ %>

            <tr>

                <td><%= customer.id %></td>

                <td><%= customer.customer_name %></td>

                <td><%= customer.company_name %></td>

                <td><%= customer.phone %></td>

                <td><%= customer.email %></td>

                <td>

                    <a
                    href="/customers/edit/<%= customer.id %>"
                    class="btn btn-warning btn-sm">

                    Edit

                    </a>

                    <a
                    href="/customers/delete/<%= customer.id %>"
                    class="btn btn-danger btn-sm"
                    onclick="return confirm('Are you sure you want to delete this customer?')">

                    Delete

                    </a>

                </td>

            </tr>

            <% }) %>

        <% } else { %>

            <tr>

                <td colspan="6" class="text-center text-danger">

                    No Customers Found

                </td>

            </tr>

        <% } %>

        </tbody>

    </table>

</div>

<script>

const search = document.getElementById("searchCustomer");

search.addEventListener("keyup", function(){

let filter = this.value.toLowerCase();

let rows = document.querySelectorAll("#customerTable tr");

rows.forEach(row=>{

let text=row.innerText.toLowerCase();

row.style.display=text.includes(filter)?"":"none";

});

});

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>